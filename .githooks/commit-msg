#!/bin/sh

commit_message_file="$1"
commit_message=$(head -n 1 "$commit_message_file")
pattern='^(feat|fix|refactor|docs|design|chore|test|style|perf|ci)(\([a-z0-9/-]+\))?: .+'

if ! printf '%s\n' "$commit_message" | grep -Eq "$pattern"; then
  echo "Invalid commit message."
  echo "Use: <type>(<scope>): <summary>"
  echo "Example: feat(meeting): 실시간 자막 상태 추가"
  exit 1
fi
