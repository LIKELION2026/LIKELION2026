{
  "name": "@likelion2026/server",
  "version": "0.1.0",
  "private": true,
  "description": "NestJS API server for the LIKELION2026 virtual office",
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "smoke:meeting-subtitle": "ts-node scripts/meeting-subtitle-smoke.ts",
    "smoke:livekit-room": "ts-node scripts/livekit-room-smoke.ts",
    "smoke:livekit-webhook": "ts-node scripts/livekit-webhook-smoke.ts",
    "start": "node dist/main.js",
    "start:dev": "pnpm --filter @likelion2026/shared build && nest start --watch",
    "test": "pnpm --filter @likelion2026/shared build && node --test -r ts-node/register test/meeting.service.test.ts test/meeting.controller.test.ts test/meeting-realtime.gateway.test.ts test/livekit-token.service.test.ts test/livekit-webhook.service.test.ts test/livekit-webhook-smoke.test.ts test/livekit-room-smoke.test.ts test/meeting-subtitle-smoke.test.ts test/environment.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@likelion2026/shared": "workspace:*",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-socket.io": "^11.2.0",
    "@nestjs/websockets": "^11.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "livekit-server-sdk": "^2.17.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@types/node": "^24.3.0",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3"
  }
}
