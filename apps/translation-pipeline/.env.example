# 이 파일을 .env로 복사한 뒤 실제 키를 채운다. .env는 커밋하지 않는다.
# 1·3단계는 키 없이 동작한다.

# 2·6단계 Deepgram STT
DEEPGRAM_API_KEY=

# 4단계 번역. 사용할 provider의 키만 채우면 된다.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# 회의방 통역 에이전트(scripts/run_agent.py). 배포 환경과 같은 값이어야
# 같은 회의방에 들어간다. Server의 .env에 있는 값과 같다.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 자막을 보낼 Server 주소. 비우면 http://localhost:4000을 쓴다.
# 배포 서버로 보내려면 Render 주소를 넣는다.
PIPELINE_SERVER_URL=
