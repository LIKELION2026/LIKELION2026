# 이 파일을 .env로 복사한 뒤 실제 키를 채운다. .env는 커밋하지 않는다.
# 1·3단계는 키 없이 동작한다.

# 2·6단계 Deepgram STT
DEEPGRAM_API_KEY=

# 4단계 번역. 사용할 provider의 키만 채우면 된다.
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# 회의방 통역 에이전트(scripts/run_agent.py). 배포 환경과 같은 값이어야
# 같은 회의방에 들어간다. Server의 .env에 있는 값과 같다.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# 자막을 보낼 Server 주소. 비우면 http://localhost:4000을 쓴다.
# 배포 서버로 보내려면 Render 주소를 넣는다.
PIPELINE_SERVER_URL=

# 통역 워커 설정. 프레임워크가 명령줄을 쓰기 때문에 인자 대신 여기서 준다.
# 비우면 코드의 기본값을 쓴다.
TRANSLATION_MODEL=
TRANSLATION_ENDPOINTING_MS=
TRANSLATION_INTERIM_INTERVAL_MS=
# 새 인식 결과가 이만큼 없으면 열린 발화를 확정한다. 0이면 끈다.
TRANSLATION_FINALIZE_AFTER_MS=
# 워커가 여러 대일 때만 의미가 있다. 이 CPU 부하를 넘으면 배정을 받지 않는다.
# 한 대로 돌리면 거부가 곧 자막 없음이라 비워 두는 편이 낫다.
TRANSLATION_LOAD_THRESHOLD=
