{
  "name": "likelion2026",
  "version": "0.1.0",
  "private": true,
  "description": "Global remote collaboration virtual office monorepo",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "pnpm --filter @likelion2026/shared build && pnpm --filter @likelion2026/server build",
    "build:server": "pnpm --filter @likelion2026/shared build && pnpm --filter @likelion2026/server build",
    "dev:server": "pnpm --filter @likelion2026/server start:dev",
    "lint": "pnpm typecheck",
    "start:server": "pnpm --filter @likelion2026/server start",
    "typecheck": "pnpm --filter @likelion2026/shared typecheck && pnpm --filter @likelion2026/server typecheck"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
